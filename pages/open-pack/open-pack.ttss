.pack-page { min-height: 100vh; box-sizing: border-box; background: #FBF7EE; background-image: radial-gradient(#D9D0C2 1px, transparent 1px); background-size: 10px 10px; padding: 12px 28px 18px; color: #111; }
.pack-loading { padding: 100px 0; text-align: center; font-size: 12px; color: #6F665C; }
.pack-error { padding: 100px 20px; text-align: center; }
.pack-error-title { margin-bottom: 18px; font-size: 14px; font-weight: 700; color: #6F665C; }
.pack-page-head { display: flex; align-items: center; justify-content: space-between; padding: 7px 0 13px; }
.pack-page-title { font-size: 14px; font-weight: 900; color: #111; }
.pack-skip-top { padding: 4px 11px; border: 2px solid #111; border-radius: 999rpx; background: #FFFDF7; font-size: 10px; font-weight: 800; color: #111; }
.pack-card { position: relative; box-sizing: border-box; width: 100%; min-height: 590px; display: flex; flex-direction: column; background: #FFFDF7; border: 3px solid #111; border-radius: 18px; box-shadow: 6px 6px 0 #111; overflow: hidden; }
.pack-card.rarity-rare { box-shadow: 6px 6px 0 #111, inset 0 0 0 4px #F2C46D; }
.pack-card.rarity-epic { box-shadow: 6px 6px 0 #111, inset 0 0 0 4px #C6B4FF; }
.pack-card.rarity-legend { box-shadow: 6px 6px 0 #111, inset 0 0 0 4px #FFE600; }
.pack-card-head { display: flex; align-items: center; justify-content: space-between; height: 39px; box-sizing: border-box; padding: 0 14px; background: #FFFDF7; border-bottom: 2px solid #111; }
.pack-logo { font-size: 13px; font-weight: 900; letter-spacing: .3px; }
.pack-logo text { font-size: 10px; color: #6F665C; }
.pack-no { font-size: 9px; font-weight: 700; color: #8A8175; letter-spacing: .5px; }
.pack-hero { position: relative; height: 330px; flex: none; background: #FFE600; overflow: hidden; }
.pack-halo { position: absolute; left: 50%; top: 47%; width: 245px; height: 245px; transform: translate(-50%, -50%); border-radius: 50%; background: rgba(255,255,255,.23); }
.pack-animals { position: absolute; left: 50%; bottom: 0; transform: translateX(-50%); display: flex; align-items: flex-end; justify-content: center; width: 280px; height: 295px; }
.pack-animals.two { width: 100%; height: 220px; display: block; }
.pack-animal { position: relative; width: 280px; height: 295px; }
.pack-animals.two .pack-animal { position: absolute; bottom: 0; width: 205px; height: 205px; }
.pack-animals.two .animal-0 { left: 30%; transform: translateX(-50%); }
.pack-animals.two .animal-1 { left: 70%; transform: translateX(-50%); }
.pack-animal-img { display: block; width: 100%; height: 100%; }
.pack-collar { position: absolute; left: 38.25%; top: 45%; width: 23.5%; height: 13px; box-sizing: border-box; border: 2px solid #111; border-radius: 5px 5px 10px 10px / 4px 4px 9px 9px; transform: rotate(-3deg); }
.pack-animals.two .pack-collar { top: 44%; width: 24%; left: 38%; }
.pack-collar-tag { position: absolute; left: 50%; margin-left: 8px; top: 12px; transform: rotate(3deg); min-width: 34px; max-width: 100px; box-sizing: border-box; padding: 2px 6px; background: #FFFDF7; border: 1.5px solid #111; border-radius: 4px; font-size: 9px; line-height: 1.35; font-weight: 900; color: #111; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.pack-prop { position: absolute; left: 61%; bottom: 3px; width: 40px; height: 40px; z-index: 4; filter: drop-shadow(0 3px 0 rgba(17,17,17,.18)); }
.pack-hero.two .pack-prop { left: 50%; bottom: 2px; width: 30px; height: 30px; transform: translateX(-50%); }
.pack-nameplate { flex: none; display: flex; flex-direction: column; justify-content: center; text-align: center; padding: 24px 14px 8px; background: #FFFDF7; }
.pack-name { font-size: 25px; font-weight: 900; line-height: 1.2; color: #111; }
.pack-sub { margin-top: 7px; font-size: 10px; font-weight: 700; color: #6F665C; }
.pack-detail { display: flex; align-items: center; justify-content: space-between; margin: auto 14px 0; padding: 11px 0 16px; border-top: 1.5px dashed #C9C0B3; font-size: 9px; font-weight: 700; color: #6F665C; }
.pack-detail-pill { padding: 3px 7px; border: 1.5px solid #111; border-radius: 999rpx; background: #FFF7CC; color: #111; }
.pack-footer { display: flex; align-items: center; justify-content: space-between; padding: 17px 2px 0; }
.pack-dots { display: flex; align-items: center; gap: 5px; }
.pack-dot { width: 6px; height: 6px; border-radius: 50%; background: #C9C0B3; }
.pack-dot.active { width: 16px; border-radius: 999rpx; background: #111; }
.pack-foot-hint { flex: 1; text-align: center; font-size: 9px; color: #8A8175; }
.pack-main-btn { min-width: 82px; margin: 0; padding: 7px 14px; background: #FFE600; border: 2px solid #111; border-radius: 999rpx; box-shadow: 3px 3px 0 #111; font-size: 11px; font-weight: 900; color: #111; line-height: 1.3; }
.pack-main-btn::after { border: 0; }
