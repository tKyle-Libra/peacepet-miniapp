.catalog-page { padding-bottom: 30px; }

/* 三视角 tab */
.view-tabs {
  display: flex;
  height: 46px;
  padding: 2px 14px 0;
  box-sizing: border-box;
  background: #FBF7EE;
}
.view-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5px;
  font-size: 15px;
  font-weight: 900;
  color: #8A8175;
}
.view-tab.active { color: #111; }
.tab-underline {
  width: 26px;
  height: 5px;
  box-sizing: border-box;
  border: 1.5px solid #111;
  border-radius: 3px;
  background: #FFE600;
  opacity: 0;
}
.tab-underline.show { opacity: 1; }

/* 筛选行 */
.filter-row {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 10px 14px 0;
}
.filter-chip {
  height: 24px;
  line-height: 20px;
  padding: 0 11px;
  box-sizing: border-box;
  background: #FFFDF7;
  border: 2px solid #111;
  border-radius: 999rpx;
  box-shadow: 2px 2px 0 #111;
  font-size: 10px;
  font-weight: 800;
  color: #6F665C;
}
.filter-chip.active { background: #FFE600; color: #111; }
.filter-count { margin-left: auto; font-size: 9px; font-weight: 700; color: #8A8175; }

/* 品牌视角：色块卡 */
.brand-grid { display: flex; flex-wrap: wrap; justify-content: space-between; padding: 12px 14px 0; }
.brand-card {
  width: calc(50% - 4px);
  box-sizing: border-box;
  background: #FFFDF7;
  border: 2.5px solid #111;
  border-radius: 12px;
  box-shadow: 4px 4px 0 #111;
  padding: 8px 9px 9px;
  margin-bottom: 8px;
}
.brand-card.complete { box-shadow: 4px 4px 0 #111, inset 0 0 0 2px #FFE600; }
.brand-head { display: flex; align-items: baseline; gap: 5px; }
.brand-name { font-size: 14.5px; font-weight: 900; color: #111; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
.brand-count { margin-left: auto; flex: none; font-size: 9px; font-weight: 800; color: #6F665C; white-space: nowrap; }
.brand-star { color: #111; margin-right: 2px; }
.brand-progress { margin-top: 5px; height: 8px; box-sizing: border-box; background: #FFFDF7; border: 2px solid #111; border-radius: 5px; overflow: hidden; }
.brand-progress-fill { height: 100%; background: #FFE600; }
.swatches { display: flex; align-items: center; gap: 4px; margin-top: 7px; }
.swatch { flex: none; box-sizing: border-box; position: relative; display: flex; align-items: center; justify-content: center; }
.swatch.is-20 { width: 20px; height: 20px; border: 2px solid #111; border-radius: 5px; }
.swatch-icon { display: block; width: 13px; height: 13px; }
.swatch-fallback { display: block; font-size: 12px; line-height: 1; }
.swatch-check { position: absolute; right: -4px; top: -5px; width: 13px; height: 13px; box-sizing: border-box; border-radius: 50%; background: #111; color: #FFE600; line-height: 1; font-size: 7px; display: flex; align-items: center; justify-content: center; }
.swatch-q { display: block; font-size: 11px; line-height: 1; font-weight: 900; color: #6F665C; }
.brand-names { margin-top: 5px; font-size: 8px; font-weight: 700; color: #6F665C; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.brand-more { margin-top: 3px; font-size: 8px; font-weight: 700; color: #8A8175; }
.pcard .swatches { margin-top: 6px; }
/* 产品视角：2 列 */
.product-grid { display: flex; flex-wrap: wrap; justify-content: space-between; padding: 10px 14px 0; }
.pcard {
  width: calc(50% - 4px);
  box-sizing: border-box;
  background: #FFFDF7;
  border: 2.5px solid #111;
  border-radius: 12px;
  box-shadow: 4px 4px 0 #111;
  padding: 9px 10px;
  margin-bottom: 8px;
}
.pcard.complete { box-shadow: 4px 4px 0 #111, inset 0 0 0 2px #FFE600; }
.pcard-top { display: flex; align-items: baseline; justify-content: space-between; gap: 5px; }
.pcard-name { font-size: 14.5px; font-weight: 900; color: #111; line-height: 1.2; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
.pcard-num { flex: none; font-size: 9px; font-weight: 800; color: #111; white-space: nowrap; }
.pcard-num.zero { color: #8A8175; font-weight: 700; }
.pcard-star { font-size: 9px; color: #111; margin-right: 2px; }
.pcard-stars { font-size: 9px; color: #111; margin-right: 3px; letter-spacing: -0.6px; white-space: nowrap; }
.pcard-brand-tag { display: inline-block; box-sizing: border-box; max-width: 100%; height: 17px; margin-top: 5px; padding: 0 6px; background: #FFF7CC; border: 1.5px solid #111; border-radius: 4px; font-size: 10px; font-weight: 900; hyphens: none; line-height: 14px; color: #111; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.pcard-segments { display: flex; height: 8px; box-sizing: border-box; margin-top: 7px; background: #E6DFD0; border: 1.5px solid #111; border-radius: 4px; overflow: hidden; }
.pcard-seg { flex: 1; min-width: 1px; height: 100%; border-right: 1px solid rgba(17,17,17,.18); }
.pcard-seg.dense { border-right: 0; }
.pcard-seg:last-child { border-right: 0; }
.pcard-bar { height: 8px; box-sizing: border-box; margin-top: 7px; background: #fff; border: 2px solid #111; border-radius: 5px; overflow: hidden; }
.pcard-fill { height: 100%; background: #FFE600; border-radius: 3px; }

.progress-placeholder { padding: 50px 14px; text-align: center; }
.placeholder-title { font-size: 18px; font-weight: 900; color: #111; }
.placeholder-sub { margin-top: 7px; font-size: 11px; color: #6F665C; }
.catalog-empty { padding: 30px 0; text-align: center; font-size: 12px; color: #6F665C; }

/* 进度视角 */
.progress-loading { padding: 35px 0; text-align: center; font-size: 12px; color: #6F665C; }
.progress-section { padding: 14px 14px 0; }
.progress-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 7px; font-size: 14px; font-weight: 900; color: #111; }
.progress-head-count { font-size: 9px; font-weight: 700; color: #8A8175; }
.progress-list { display: flex; flex-direction: column; gap: 7px; }
.progress-row {
  display: flex;
  align-items: center;
  gap: 8px;
  background: #FFFDF7;
  border: 2.5px solid #111;
  border-radius: 11px;
  box-shadow: 3px 3px 0 #111;
  padding: 8px 11px;
}
.progress-name { font-size: 13px; font-weight: 900; color: #111; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.progress-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
.progress-sub { font-size: 8px; font-weight: 700; color: #8A8175; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.progress-right { display: flex; align-items: center; gap: 7px; flex: none; }
.remain-tag { flex: none; padding: 2px 6px; border: 1.5px solid #111; border-radius: 999rpx; background: #FFFDF7; font-size: 8px; font-weight: 800; color: #6F665C; white-space: nowrap; }
.mini-bar { width: 52px; height: 8px; box-sizing: border-box; border: 1.5px solid #111; border-radius: 4px; background: #fff; overflow: hidden; }
.mini-fill { height: 100%; background: #FFE600; }
.progress-arrow { font-size: 18px; line-height: 1; font-weight: 900; color: #111; }
.done-tag { flex: none; padding: 2px 6px; background: #FFE600; border: 1.5px solid #111; border-radius: 4px; font-size: 8px; font-weight: 900; color: #111; white-space: nowrap; }
.progress-empty { padding: 12px; text-align: center; font-size: 10px; color: #8A8175; }
.done-empty-brand {
  margin: 0;
  padding: 22px 18px 20px;
  border: 2px dashed #B9B3A8;
  border-radius: 12px;
  text-align: center;
  background: #FFFDF7;
}
.done-empty-zero { display: block; font-size: 42px; line-height: 1; font-weight: 900; color: #B9B3A8; }
.done-empty-title { display: block; margin-top: 12px; font-size: 12px; font-weight: 900; color: #111; }
.done-empty-sub { display: block; margin-top: 5px; font-size: 9px; color: #8A8175; line-height: 1.5; }
.done-empty-product { margin: 0; padding: 12px; border: 2px dashed #B9B3A8; border-radius: 9px; text-align: center; font-size: 10px; color: #8A8175; background: #FFFDF7; }

/* 顶部 B：大数字 + 目录签 */
.topB { padding: 10px 14px 0; }
.topB-main { display: flex; align-items: flex-start; gap: 10px; height: 94px; }
.topB-left { width: 152px; flex: none; min-width: 0; }
.topB-label-row { display: flex; align-items: center; justify-content: space-between; gap: 4px; }
.topB-label { font-size: 9px; font-weight: 700; color: #6F665C; line-height: 1.2; }
.pet-switch { display: flex; gap: 3px; flex: none; }
.pet-chip { padding: 1px 5px; border: 1.5px solid #111; border-radius: 999rpx; background: #FFFDF7; font-size: 8px; font-weight: 800; color: #6F665C; line-height: 1.5; }
.pet-chip.active { background: #FFE600; color: #111; border-width: 2px; }
.topB-number { display: flex; align-items: baseline; margin-top: 2px; white-space: nowrap; }
.topB-big { font-size: 40px; line-height: 1; font-weight: 900; color: #111; letter-spacing: -1.8px; }
.topB-den { margin-left: 4px; font-size: 14px; line-height: 1; font-weight: 900; color: #8A8175; }
.topB-bar { width: 152px; height: 10px; box-sizing: border-box; margin-top: 7px; background: #FFFDF7; border: 2px solid #111; border-radius: 6px; overflow: hidden; }
.topB-fill { height: 100%; background: #FFE600; border-radius: 3px; }
.topB-sub { margin-top: 4px; font-size: 9px; font-weight: 700; color: #6F665C; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.topB-sub-strong { font-weight: 900; color: #111; }
.topB-sub-rest { font-weight: 700; color: #6F665C; }
.topB-entries { width: 185px; flex: none; display: flex; flex-direction: column; gap: 5px; }
.topB-entry {
  width: 185px;
  height: 28px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 10px;
  background: #FFFDF7;
  border: 2px solid #111;
  border-radius: 8px;
  box-shadow: 2px 2px 0 #111;
  font-size: 12px;
  font-weight: 900;
  color: #6F665C;
}
.topB-entry.active {
  background: #FFE600;
  border-width: 2.5px;
  box-shadow: 3px 3px 0 #111;
  color: #111;
  transform: translateX(-3px);
}
.topB-arrow { font-size: 10px; font-weight: 900; color: #8A8175; }
.topB-entry.active .topB-arrow { color: #111; }
.topB .filter-row { margin-top: 10px; padding: 9px 0 0; border-top: 1.5px dashed rgba(17,17,17,.14); }
.brand-hint-row { margin: 10px 0 0; padding: 9px 0 0; border-top: 1.5px dashed rgba(17,17,17,.14); font-size: 9px; font-weight: 700; color: #8A8175; }
.filter-update { margin-left: auto; font-size: 8.5px; font-weight: 700; color: #8A8175; }
.brand-grid, .product-grid { padding-top: 12px; }

/* 我的视角：与品牌卡/产品卡同一套双列卡 */
.my-grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.my-grid .pcard { margin-bottom: 8px; }
