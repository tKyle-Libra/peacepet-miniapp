.flavors-page { position: relative; height: 100vh; overflow: hidden; }
.flavors-scroll { height: 100vh; box-sizing: border-box; padding: 14px 14px 30px; }
.wall-hero {
  background: #FFFFFF;
  border: 2.5px solid #111;
  border-radius: 10px;
  box-shadow: 4px 4px 0 #111;
  padding: 13px 14px 12px;
  margin-bottom: 16px;
}
.wall-hero.complete { box-shadow: inset 0 0 0 2px #FFE600, 4px 4px 0 #111; }
.wall-title { font-size: 22px; font-weight: 900; color: #111; }
.wall-stats { display: flex; justify-content: space-between; align-items: baseline; margin-top: 7px; font-size: 11px; font-weight: 800; color: #6F665C; }
.wall-completed { font-size: 15px; font-weight: 900; color: #111; }
.cat-bar { height: 13px; box-sizing: border-box; margin-top: 8px; background: #fff; border: 2.5px solid #111; border-radius: 8px; overflow: hidden; }
.cat-bar-fill { height: 100%; background: #FFE600; border-radius: 5px; }
.segments { display: flex; height: 9px; margin-top: 9px; border: 1.5px solid #111; border-radius: 3px; overflow: hidden; background: #E6DFD0; }
.seg { flex: 1; min-width: 1px; height: 100%; border-right: 0.5px solid rgba(17,17,17,.25); }
.seg:last-child { border-right: 0; }
.flavor-grid { display: flex; flex-wrap: wrap; }
.flavor-cell { width: 25%; box-sizing: border-box; padding: 0 4px 13px; text-align: center; }
.flavor-tile {
  width: 52px;
  height: 52px;
  margin: 0 auto;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  border: 2.5px solid #111;
  border-radius: 7px;
}
.flavor-tile.lit { box-shadow: 2.5px 2.5px 0 #111; }
.flavor-tile.unlit { border: 2px dashed #B9B3A8; box-shadow: none; }
.flavor-check {
  position: absolute;
  top: -5px;
  right: -3px;
  width: 17px;
  height: 17px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2px solid #111;
  border-radius: 50%;
  background: #FFFDF5;
  font-size: 9px;
  line-height: 1;
  font-weight: 900;
  color: #111;
}
.flavor-icon { display: block; width: 24px; height: 24px; }
.flavor-fallback { font-size: 18px; line-height: 1; }
.sheet-fallback { font-size: 20px; line-height: 1; }
.flavor-question { font-size: 18px; font-weight: 900; color: #8A8175; }
.flavor-name { margin-top: 5px; font-size: 8.5px; font-weight: 800; color: #8A8175; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.flavor-name.on { color: #111; }
.wall-state-row { margin-top: 8px; }
.state-tag { display: inline-block; padding: 2px 6px; border-radius: 4px; font-size: 9px; font-weight: 900; line-height: 1.35; }
.state-tag.complete { background: #FFE600; border: 1.5px solid #111; color: #111; }
.state-tag.unstarted { background: #E6DFD0; border: 1.5px dashed #B9B3A8; color: #8A8175; }
.wall-empty { padding: 30px 0; text-align: center; font-size: 12px; color: #6F665C; }
.sheet-mask { position: absolute; top: 0; right: 0; bottom: 0; left: 0; z-index: 120; background: transparent; display: flex; align-items: flex-end; justify-content: center; }
.sheet {
  width: 100%;
  box-sizing: border-box;
  background: #FBF7EE;
  border: 3px solid #111;
  border-bottom: 0;
  border-radius: 20px 20px 0 0;
  box-shadow: 0 -5px 0 #111;
  padding: 9px 16px 24px;
  max-height: 82vh;
  overflow-y: auto;
}
.sheet-grab { width: 36px; height: 4px; border-radius: 3px; background: #B9B3A8; margin: 0 auto 14px; }
.sheet-loading { padding: 30px 0; text-align: center; font-size: 12px; color: #6F665C; }
.sheet-head { display: flex; align-items: center; gap: 12px; }
.sheet-color {
  position: relative;
  width: 58px;
  height: 58px;
  flex: none;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2.5px solid #111;
  border-radius: 8px;
}
.sheet-color.unlit { background: #EDE7DA; border: 2px dashed #B9B3A8; }
.sheet-icon { width: 27px; height: 27px; display: block; }
.sheet-check {
  position: absolute;
  top: 2px;
  right: 2px;
  width: 17px;
  height: 17px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2px solid #111;
  border-radius: 50%;
  background: #FFFDF5;
  font-size: 9px;
  line-height: 1;
  font-weight: 900;
  color: #111;
}
.sheet-heading { flex: 1; min-width: 0; }
.sheet-name { font-size: 21px; font-weight: 900; color: #111; }
.sheet-sub { margin-top: 3px; font-size: 10.5px; color: #6F665C; }
.sheet-state { display: inline-block; margin-top: 5px; padding: 2px 7px; border: 1.5px solid #111; border-radius: 4px; background: #EDE7DA; font-size: 9.5px; font-weight: 900; color: #6F665C; }
.sheet-state.on { background: #FFE600; color: #111; }
.sheet-rows { margin-top: 15px; border-top: 2px dashed rgba(17,17,17,.2); padding-top: 7px; }
.sheet-row { display: flex; justify-content: space-between; align-items: center; padding: 8px 0; border-bottom: 1px solid rgba(17,17,17,.08); font-size: 12px; color: #6F665C; }
.sheet-row-val { color: #111; font-weight: 800; }
.sheet-social { display: flex; align-items: center; gap: 6px; margin-top: 11px; font-size: 10.5px; font-weight: 700; color: #6F665C; }
.sheet-social-dot { width: 7px; height: 7px; border-radius: 50%; background: #FFE600; border: 1.5px solid #111; box-sizing: border-box; flex: none; }
.receipt-btn { margin-top: 16px; }
.sheet-locked { margin-top: 16px; padding: 12px 10px; text-align: center; border: 2px dashed #B9B3A8; border-radius: 7px; font-size: 10.5px; color: #8A8175; }



/* 未开放口味提示：只有底部卡片，没有灰色蒙版 */
.unready-layer { position: absolute; left: 0; right: 0; bottom: 0; z-index: 130; padding: 0 14px 22px; }
.unready-card {
  background: #FBF7EE;
  border: 3px solid #111;
  border-radius: 18px;
  box-shadow: 5px 5px 0 #111;
  padding: 18px 16px 16px;
}
.unready-title { font-size: 18px; font-weight: 900; color: #111; }
.unready-text { margin-top: 7px; font-size: 11.5px; line-height: 1.55; color: #6F665C; }
.unready-btn { margin-top: 14px; }
