.brand-page { padding: 14px 14px 30px; }
.brand-hero {
  background: #FFFFFF;
  border: 2.5px solid #111;
  border-radius: 10px;
  box-shadow: 4px 4px 0 #111;
  padding: 13px 14px 12px;
  margin-bottom: 16px;
}
.brand-hero { display: flex; align-items: flex-start; gap: 8px; position: relative; overflow: hidden; }
.brand-copy { flex: 1; min-width: 0; position: relative; z-index: 2; }
.brand-title { font-size: 22px; font-weight: 900; color: #111; line-height: 1.15; }
.brand-animal-wrap { flex: none; width: 168px; height: 230px; margin-top: -10px; margin-right: -12px; position: relative; }
.brand-animal { display: block; width: 100%; height: 100%; }
.brand-collar { position: absolute; left: 38.25%; top: 45%; width: 23.5%; height: 13px; box-sizing: border-box; border: 2px solid #111; border-radius: 5px 5px 10px 10px / 4px 4px 9px 9px; transform: rotate(-3deg); }
.brand-collar-tag { position: absolute; left: 50%; margin-left: 8px; top: 12px; transform: rotate(3deg); min-width: 30px; max-width: 86px; box-sizing: border-box; padding: 2px 6px; background: #FFFDF7; border: 1.5px solid #111; border-radius: 4px; color: #111; font-size: 9px; font-weight: 900; line-height: 1.3; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.brand-social { margin-top: 7px; font-size: 10px; font-weight: 700; color: #6F665C; }
.brand-stats { display: flex; justify-content: space-between; align-items: baseline; margin-top: 7px; font-size: 11px; font-weight: 800; color: #6F665C; }
.brand-pct { font-size: 20px; font-weight: 900; color: #111; }
.cat-bar {
  height: 13px;
  box-sizing: border-box;
  margin-top: 8px;
  background: #fff;
  border: 2.5px solid #111;
  border-radius: 8px;
  overflow: hidden;
}
.cat-bar-fill { height: 100%; background: #FFE600; border-radius: 5px; }
.segments { display: flex; height: 9px; margin-top: 9px; border: 1.5px solid #111; border-radius: 3px; overflow: hidden; background: #E6DFD0; }
.seg { flex: 1; min-width: 1px; height: 100%; border-right: 0.5px solid rgba(17,17,17,.25); }
.seg:last-child { border-right: 0; }
.sort-row { display: flex; gap: 8px; margin: 0 2px 12px; }
.sort-chip {
  padding: 5px 10px;
  box-sizing: border-box;
  border: 2px solid #111;
  border-radius: 999rpx;
  background: #fff;
  color: #6F665C;
  font-size: 10.5px;
  font-weight: 800;
}
.sort-chip.active { background: #FFE600; color: #111; box-shadow: 2px 2px 0 #111; }
.product-grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.pcard {
  width: calc(50% - 4px);
  box-sizing: border-box;
  background: #FFFDF7;
  border: 2.5px solid #111;
  border-radius: 12px;
  box-shadow: 4px 4px 0 #111;
  padding: 9px 10px;
  margin-bottom: 8px;
}
.pcard.complete { box-shadow: 4px 4px 0 #111, inset 0 0 0 2px #FFE600; }
.pcard-row { display: flex; align-items: baseline; gap: 5px; }
.pcard-name { font-size: 14.5px; font-weight: 900; line-height: 1.2; color: #111; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
.pcard-num { margin-left: auto; flex: none; font-size: 9px; font-weight: 800; color: #111; white-space: nowrap; }
.pcard-num.zero { color: #8A8175; font-weight: 700; }
.pcard-star { font-size: 9px; color: #111; margin-right: 2px; }
.pcard-stars { font-size: 9px; color: #111; margin-right: 3px; letter-spacing: -0.6px; white-space: nowrap; }
.pcard-brand-tag { display: inline-block; box-sizing: border-box; max-width: 100%; height: 17px; margin-top: 5px; padding: 0 6px; background: #FFF7CC; border: 1.5px solid #111; border-radius: 4px; font-size: 10px; font-weight: 900; line-height: 14px; color: #111; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.pcard-segments { display: flex; height: 8px; box-sizing: border-box; margin-top: 7px; background: #E6DFD0; border: 1.5px solid #111; border-radius: 4px; overflow: hidden; }
.pcard-seg { flex: 1; min-width: 1px; height: 100%; border-right: 1px solid rgba(17,17,17,.18); }
.pcard-seg.dense { border-right: 0; }
.pcard-seg:last-child { border-right: 0; }
.pcard-bar { margin-top: 7px; height: 8px; box-sizing: border-box; background: #FFFDF7; border: 2px solid #111; border-radius: 5px; overflow: hidden; }
.pcard-fill { height: 100%; background: #FFE600; }
.product-count-note { margin-top: 4px; padding: 2px 0 8px; text-align: center; font-size: 8px; font-weight: 700; color: #8A8175; }
.brand-empty { padding: 30px 0; text-align: center; font-size: 12px; color: #6F665C; }

/* 产品卡口味色块（与首页品牌卡同规格） */
.pcard .swatches { display: flex; align-items: center; gap: 4px; margin-top: 6px; }
.pcard .swatch { flex: none; box-sizing: border-box; position: relative; display: flex; align-items: center; justify-content: center; }
.pcard .swatch.is-20 { width: 20px; height: 20px; border: 2px solid #111; border-radius: 5px; }
.pcard .swatch-icon { display: block; width: 13px; height: 13px; }
.pcard .swatch-fallback { display: block; font-size: 12px; line-height: 1; }
.pcard .swatch-check { position: absolute; right: -4px; top: -5px; width: 13px; height: 13px; box-sizing: border-box; border-radius: 50%; background: #111; color: #FFE600; line-height: 1; font-size: 7px; display: flex; align-items: center; justify-content: center; }
.pcard .swatch-q { display: block; font-size: 11px; line-height: 1; font-weight: 900; color: #6F665C; }
