<view class="page flavor-receipts-page">
  <view class="loading" tt:if="{{loading && page === 1}}">加载中…</view>
  <view class="errbox" tt:if="{{error}}">
    <view class="err">{{error}}</view>
    <button class="btn" bindtap="retry">重试</button>
  </view>

  <view class="empty" tt:if="{{!loading && !error && receipts.length === 0}}">
    <view class="empty-icon">🧾</view>
    <view class="empty-title">没有找到相关小票</view>
  </view>

  <view class="list" tt:if="{{receipts.length > 0}}">
    <view class="ord" tt:for="{{receipts}}" tt:key="id" data-id="{{item.id}}" bindtap="openReceipt">
      <view class="ord-top">
        <text class="tag {{item.is_refund ? 'refund' : 'member'}}" tt:if="{{item.is_refund}}">退款</text>
        <text class="tag member" tt:elif="{{item.member_linked}}">会员单</text>
        <text class="ord-date">{{item.date_text}} {{item.time}}</text>
        <text class="ord-no">No.{{item.order_tail}}</text>
      </view>
      <view class="ord-mid">{{item.item_summary}}</view>
      <view class="ord-bot">
        <text class="store">PeacePet · 共 {{item.item_count}} 件</text>
        <text class="pay {{item.is_refund ? 'red' : ''}}">{{item.pay_text}}</text>
      </view>
    </view>
    <view class="more" tt:if="{{hasMore}}">上拉加载更多</view>
    <view class="flavor-receipts-foot">共 {{total}} 张</view>
  </view>
</view>
