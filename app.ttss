page {
  background: #E7E1D4;
  color: #111;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
}
.page {
  min-height: 100vh;
  background-color: #FBF7EE;
  background-image: radial-gradient(rgba(17,17,17,.05) 1px, transparent 1.2px);
  background-size: 9px 9px;
}
.topbar {
  position: sticky;
  top: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  gap: 9px;
  padding: calc(12px + env(safe-area-inset-top)) 14px 10px;
  background: rgba(251,247,238,.96);
  border-bottom: 1.5px solid rgba(17,17,17,.08);
}
.back {
  width: 34px;
  height: 34px;
  border: 2.5px solid #111;
  border-radius: 8px;
  background: #fff;
  box-shadow: 3px 3px 0 #111;
  font-size: 20px;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-bottom: 3px;
}
.titles { flex: 1; min-width: 0; }
.appttl { font-size: 19px; font-weight: 900; letter-spacing: -.3px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.appsub { font-size: 10.5px; color: #6F665C; margin-top: 2px; }
.graphbtn {
  flex: none;
  background: #fff;
  border: 2.5px solid #111;
  border-radius: 999px;
  padding: 5px 11px;
  font-size: 11.5px;
  font-weight: 800;
  box-shadow: 2.5px 2.5px 0 #111;
}
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  border: 2.5px solid #111;
  border-radius: 9px;
  background: #fff;
  color: #111;
  font-size: 14px;
  font-weight: 900;
  min-height: 88rpx;
  line-height: 1.3;
  padding: 11px 12px;
  box-shadow: 4px 4px 0 #111;
  margin-top: 14px;
  box-sizing: border-box;
}
.btn.primary { background: #FFE600; }
.btn:active { transform: translateY(2px); box-shadow: 2px 2px 0 #111; }
.btn[disabled] { opacity: .55; }
.muted { color: #6F665C; }
.err { color: #D9302C; font-size: 11.5px; font-weight: 700; line-height: 1.4; }
.center { text-align: center; }
